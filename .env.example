# Local development uses file:./data/golden-savanna.db when TURSO_DATABASE_URL is empty.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required in production. Use at least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional backwards-compatible bootstrap for an empty local/legacy database.
# New public installations can create their first room in the interface.
OWNER_NAME=Артём
OWNER_PIN=2468

PUBLIC_APP_URL=http://localhost:3000

# Optional direct links shown only for the review trap. Keep studio cards separate.
NEXT_PUBLIC_REVIEW_YANDEX_MACHUGI=
NEXT_PUBLIC_REVIEW_2GIS_MACHUGI=
NEXT_PUBLIC_REVIEW_GOOGLE_MACHUGI=
NEXT_PUBLIC_REVIEW_YANDEX_STAVROPOLSKAYA=
NEXT_PUBLIC_REVIEW_2GIS_STAVROPOLSKAYA=
NEXT_PUBLIC_REVIEW_GOOGLE_STAVROPOLSKAYA=

# MAX API endpoint is global. Bot tokens and chat IDs are saved per room
# by its manager in "Доступ и сезон". The four legacy variables below are
# imported only into an existing single room during migration.
MAX_API_BASE=https://platform-api2.max.ru
MAX_BOT_TOKEN=replace-with-max-bot-token
MAX_CHAT_ID=replace-with-max-chat-id

# Legacy single-room migration only; new rooms are configured in the UI.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-group-chat-id

# Vercel Cron and Blob backups
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
