{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "5 21 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "15 1 * * *"
    }
  ]
}
